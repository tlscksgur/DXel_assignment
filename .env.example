# 운영에서는 HTTPS 앱 주소와 회사 SMTP 값을 .env에 설정하세요. SMTP 비밀값은 저장소에 올리지 마세요.
APP_BASE_URL=http://localhost:3000
# 하위 경로 배포 예: https://서비스주소:7777/businessCard
# 앱 경로는 APP_BASE_URL에서 자동 결정됩니다. Ubuntu 예시는 deploy/README.md 참고.
PORT=3000
HOST=0.0.0.0
# 같은 서버의 Nginx 뒤에서 실행할 때만 loopback으로 설정
TRUST_PROXY=
APP_ALLOWED_ORIGINS=
# 관리자 이메일을 쉼표로 구분합니다. 예: first@example.com,second@example.com
# 등록된 계정의 공유 명함 관리만 허용하며 다른 사용자의 개인 명함은 접근 불가. 비워 두면 관리자 없음.
CARD_ADMIN_EMAIL=

SMTP_HOST=
SMTP_PORT=
# 587은 false(STARTTLS), 465는 true(암시적 TLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
