[Unit]
Description=DXel business card web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chshin
WorkingDirectory=/data/chshin/cksgur/DXel_assignment
EnvironmentFile=/data/chshin/cksgur/DXel_assignment/.env
# 서버에서 command -v node 결과와 같은 절대 경로로 맞추세요.
ExecStart=/usr/bin/node /data/chshin/cksgur/DXel_assignment/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
