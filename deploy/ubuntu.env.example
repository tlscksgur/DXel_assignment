# HTTP 연결 점검용. 실제 계정 운영 전 HTTPS 주소로 바꾸고 NODE_ENV=production을 설정하세요.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://61.39.70.66:7777/businessCard
# 내부 IP로 직접 로그인할 필요가 있을 때만 추가. 메일 링크는 위 공개 주소로 생성됩니다.
APP_ALLOWED_ORIGINS=http://192.168.210.10:7777
# 전체 명함 수정·삭제·복원을 허용할 인증된 계정 이메일. 개인 즐겨찾기·그룹은 공유하지 않음.
CARD_ADMIN_EMAIL=
# 가입을 허용할 이메일 도메인을 쉼표로 구분합니다. 예: dxel.co.kr
# 비워 두면 어떤 이메일로든 가입할 수 있어 인증된 외부인도 공유 명함을 볼 수 있습니다.
SIGNUP_EMAIL_DOMAINS=
TRUST_PROXY=loopback

AI_SERVER_ENDPOINT=http://192.168.210.10:8080/v1/chat/completions
AI_SERVER_STATUS_URL=http://192.168.210.10:8080/health
AI_SERVER_MODEL=unsloth/Qwen3.8-27B-GGUF
# Unsloth Studio의 상태 주소는 /api/health입니다. 인증이 필요하면 발급받은 키를 입력하세요.
AI_SERVER_API_KEY=

SMTP_HOST=smtp.mailplug.co.kr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
